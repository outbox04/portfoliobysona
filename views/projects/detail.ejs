<!DOCTYPE html>
<html lang="vi" data-theme="dark" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= project.title %> — Trần Hồng Sơn</title>
  <meta name="description" content="<%= project.short %>" />
  <link rel="canonical" href="<%= siteUrl %>/projects/<%= project.id %>" />
  <meta property="og:type"         content="article" />
  <meta property="og:url"          content="<%= siteUrl %>/projects/<%= project.id %>" />
  <meta property="og:title"        content="<%= project.title %> — Trần Hồng Sơn" />
  <meta property="og:description"  content="<%= project.short %>" />
  <meta property="og:image"        content="<%= siteUrl %><%= project.thumb %>" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"       content="vi_VN" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="<%= project.title %>" />
  <meta name="twitter:image"       content="<%= siteUrl %><%= project.thumb %>" />
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="cursorFollower"></div>

<nav class="nav scrolled" id="nav">
  <a href="/" class="nav__logo">HS<span>.</span></a>
  <div class="nav__right">
    <ul class="nav__links" id="navLinks">
      <li><a href="/#about"      class="nav__link">Giới thiệu</a></li>
      <li><a href="/#skills"     class="nav__link">Kỹ năng</a></li>
      <li><a href="/#experience" class="nav__link">Kinh nghiệm</a></li>
      <li><a href="/#projects"   class="nav__link">Dự án</a></li>
      <li><a href="/#contact"    class="nav__link">Liên hệ</a></li>
    </ul>
    <button class="theme-toggle" id="themeToggle" aria-label="Chuyển giao diện">
      <span class="theme-toggle__icon moon">🌙</span>
      <span class="theme-toggle__icon sun">☀️</span>
    </button>
    <button class="nav__toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<section class="detail-hero">
  <div class="container">
    <div class="detail-hero__back reveal-up">
      <a href="/#projects" class="btn btn--back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Quay lại dự án
      </a>
    </div>
    <div class="detail-hero__cat reveal-up"><%= project.catLabel %></div>
    <h1 class="detail-hero__title reveal-up"><%= project.title %></h1>
    <p class="detail-hero__desc reveal-up"><%= project.desc %></p>
    <div class="detail-hero__tags reveal-up">
      <% project.tags.forEach(function(t) { %><span class="detail-hero__tag"><%= t %></span><% }); %>
    </div>
  </div>
</section>

<div class="container">
  <img src="<%= project.cover %>" alt="<%= project.title %>" class="detail-cover reveal-scale" onerror='this.style.background="var(--bg-4)";this.src=""' />
</div>

<section class="detail-body">
  <div class="container">
    <div class="detail-grid">
      <div class="detail-content reveal-up">
        <h2>Về dự án</h2>
        <p><%= project.desc %></p>
        <p>Dự án thuộc mảng <strong><%= project.catLabel %></strong>, sử dụng các công cụ và kỹ năng chuyên sâu để đạt được kết quả tốt nhất cho doanh nghiệp khách hàng.</p>

        <!-- YouTube embed -->
<% if (project.youtube) { %>
<div class="detail-video reveal-up">
  <iframe
    src="<%= project.youtube %>?rel=0&modestbranding=1"
    title="<%= project.title %>"
    frameborder="0"
    allowfullscreen
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  ></iframe>
</div>
<% } %>

<!-- Facebook Video embed -->
<!-- Facebook Video embed -->
<% if (project.facebook) { %>
<div class="detail-video detail-video--reel reveal-up">
  <iframe
    src="<%= project.facebook %>"
    title="<%= project.title %>"
    frameborder="0"
    allowfullscreen
    allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
  ></iframe>
</div>
<% } %>

        <% if (project.images && project.images.length > 0) { %>
        <div class="detail-images">
          <% project.images.forEach(function(img) { %>
          <img src="<%= img %>" alt="<%= project.title %>" onerror='this.style.background="var(--bg-4)";this.src=""' loading="lazy" />
          <% }); %>
        </div>
        <% } %>
      </div>

      <div class="detail-sidebar reveal-right">
        <div class="results-card">
          <h3>Kết quả đạt được</h3>
          <ul>
            <% project.results.forEach(function(r) { %><li><%= r %></li><% }); %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (related && related.length > 0) { %>
<section class="related-section">
  <div class="container">
    <h2 class="related-title reveal-up">Dự án liên quan</h2>
    <div class="related-grid">
      <% related.forEach(function(p) { %>
      <a href="/projects/<%= p.id %>" class="project-card reveal-up" data-cat="<%= p.cat %>">
        <div class="project-card__img">
          <img src="<%= p.thumb %>" alt="<%= p.title %>" onerror='this.parentElement.style.background="var(--bg-4)";this.style.display="none"' loading="lazy" />
          <div class="project-card__overlay">
            <span class="overlay-cat"><%= p.catLabel %></span>
            <span class="overlay-link">Xem chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </div>
        <div class="project-card__body">
          <span class="project-tag <%= p.cat %>"><%= p.catLabel %></span>
          <h4><%= p.title %></h4>
          <p><%= p.short %></p>
        </div>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="download-cv">
  <div class="container">
    <div class="download-cv__inner reveal-up">
      <div class="download-cv__text">
        <h3>Tải CV của tôi</h3>
        <p>Xem đầy đủ kinh nghiệm và thành tích trong file CV</p>
      </div>
      <a href="/download-cv" class="btn btn--download">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Tải xuống CV
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <p>© 2026 Trần Hồng Sơn — Marketing Portfolio</p>
  </div>
</footer>

<script src="/js/main.js"></script>
<script defer src="/_vercel/insights/script.js"></script>
</body>
</html>