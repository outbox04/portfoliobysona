<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<%- include('./partials/head', {
  title: 'Checkout | HS Marketing & AI Shop',
  description: 'Thanh toan digital products bang bank transfer, Momo, VNPay hoac Stripe-ready.',
  canonical: '/checkout',
  siteUrl
}) %>
<body class="shop-page">
<%- include('./partials/nav') %>

<main>
  <section class="checkout-layout">
    <form class="checkout-form" data-checkout-form>
      <span class="eyebrow">Secure Checkout</span>
      <h1>Thanh toan</h1>
      <div class="field-grid">
        <label>Email <input type="email" name="email" required placeholder="you@company.com" /></label>
        <label>Phone <input name="phone" placeholder="0987 603 615" /></label>
        <label>Company <input name="company" placeholder="Company name" /></label>
        <label>Tax code <input name="tax" placeholder="Optional" /></label>
      </div>
      <h2>Payment method</h2>
      <div class="payment-grid">
        <label><input type="radio" name="payment" checked /> Bank transfer</label>
        <label><input type="radio" name="payment" /> Momo</label>
        <label><input type="radio" name="payment" /> VNPay</label>
        <label><input type="radio" name="payment" /> Stripe ready</label>
      </div>
      <button class="btn btn--primary" type="submit">Hoan tat don hang</button>
      <div class="success-panel" data-checkout-success hidden>
        <strong>Order received.</strong>
        <p>Ban se nhan email xac nhan va link tai digital product sau khi thanh toan duoc ghi nhan.</p>
      </div>
    </form>
    <aside class="summary-card" data-cart-summary>
      <h2>Order Summary</h2>
      <div data-cart-list data-checkout-mini></div>
      <div><span>Subtotal</span><strong data-subtotal>0d</strong></div>
      <div><span>VAT</span><strong data-vat>0d</strong></div>
      <div class="summary-total"><span>Total</span><strong data-total>0d</strong></div>
    </aside>
  </section>
</main>

<%- include('./partials/footer', { shop }) %>
</body>
</html>
