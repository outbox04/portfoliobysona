<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<%- include('./partials/head', {
  title: 'Account | HS Marketing & AI Shop',
  description: 'Quản lý tổng quan, đơn hàng, thư viện đã mua, membership và profile.',
  canonical: section === 'overview' ? '/account' : '/account/' + section,
  siteUrl
}) %>
<body class="shop-page">
<%- include('./partials/nav') %>

<main class="account-shell">
  <aside class="account-sidebar">
    <a class="<%= section === 'overview' ? 'is-active' : '' %>" href="/account">Tổng quan</a>
    <a class="<%= section === 'orders' ? 'is-active' : '' %>" href="/account/orders">Đơn hàng</a>
    <a class="<%= section === 'library' ? 'is-active' : '' %>" href="/account/library">Thư viện đã mua</a>
    <a href="/shop/category/membership">Membership</a>
    <a class="<%= section === 'profile' ? 'is-active' : '' %>" href="/account/profile">Profile</a>
    <a href="/login">Security</a>
    <a href="/login">Logout</a>
  </aside>

  <section class="account-content">
    <% if (section === 'overview') { %>
      <span class="eyebrow">Dashboard</span>
      <h1>Tổng quan</h1>
      <div class="account-metrics">
        <div><strong>4</strong><span>Sản phẩm đã mua</span></div>
        <div><strong>1</strong><span>Membership đang hoạt động</span></div>
        <div><strong>2</strong><span>Tải xuống đang chờ</span></div>
      </div>
      <div class="library-grid">
        <% shop.products.slice(0, 3).forEach(product => { %>
          <article class="library-card">
            <img src="<%= product.thumbnail %>" alt="" loading="lazy" />
            <h3><%= product.title %></h3>
            <p>Đang có quyền truy cập</p>
            <a class="btn btn--ghost" href="/shop/product/<%= product.slug %>">Mở tài nguyên</a>
          </article>
        <% }) %>
      </div>
    <% } %>

    <% if (section === 'orders') { %>
      <span class="eyebrow">Orders</span>
      <h1>Đơn hàng</h1>
      <div class="order-table">
        <div class="order-row order-row--head"><span>Mã đơn</span><span>Ngày</span><span>Trạng thái</span><span>Số tiền</span><span>Hành động</span></div>
        <% shop.orders.forEach(order => { %>
          <div class="order-row">
            <span><%= order.id %></span>
            <span><%= order.date %></span>
            <span class="status status--<%= order.status %>"><%= order.status %></span>
            <span><%= order.amount %></span>
            <a href="#">Tải hoá đơn</a>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (section === 'library') { %>
      <span class="eyebrow">Library</span>
      <h1>Thư viện đã mua</h1>
      <div class="library-grid">
        <% shop.products.slice(0, 5).forEach(product => { %>
          <article class="library-card">
            <img src="<%= product.thumbnail %>" alt="" loading="lazy" />
            <h3><%= product.title %></h3>
            <p><%= product.category === 'membership' ? 'Hết hạn 2026-06-30' : 'Truy cập trọn đời' %></p>
            <div>
              <a class="btn btn--primary" href="#">Tải xuống</a>
              <a class="btn btn--ghost" href="/shop/product/<%= product.slug %>">Mở</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>

    <% if (section === 'profile') { %>
      <span class="eyebrow">Profile</span>
      <h1>Thông tin tài khoản</h1>
      <form class="checkout-form">
        <div class="field-grid">
          <label>Họ tên <input value="Tran Hong Son" /></label>
          <label>Email <input value="decaztran@gmail.com" /></label>
          <label>Company <input placeholder="Company" /></label>
          <label>Vai trò <input placeholder="Founder / Marketer" /></label>
        </div>
        <button class="btn btn--primary" type="button">Lưu hồ sơ</button>
      </form>
    <% } %>
  </section>
</main>

<%- include('./partials/footer', { shop }) %>
</body>
</html>
