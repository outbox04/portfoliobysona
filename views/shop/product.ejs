<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<%- include('./partials/head', {
  title: product.title + ' | HS Marketing & AI Shop',
  description: product.short,
  canonical: '/shop/product/' + product.slug,
  siteUrl
}) %>
<body class="shop-page">
<%- include('./partials/nav') %>

<main>
  <section class="product-detail">
    <article class="product-main">
      <div class="product-hero-media">
        <img src="<%= product.thumbnail %>" alt="<%= product.title %>" loading="eager" decoding="async" width="1200" height="760" />
        <span class="product-badge"><%= product.badge %></span>
      </div>
      <div class="product-title-block">
        <div class="tag-row">
          <% product.tags.forEach(tag => { %><span><%= tag %></span><% }) %>
        </div>
        <h1><%= product.title %></h1>
        <p><%= product.short %></p>
      </div>

      <section class="detail-block">
        <h2>Tổng quan</h2>
        <p>Sản phẩm được thiết kế như một operating kit: rõ đầu vào, rõ đầu ra, có checklist và template để team triển khai ngay thay vì đọc lý thuyết.</p>
      </section>

      <section class="detail-block">
        <h2>Bao gồm những gì</h2>
        <div class="check-grid">
          <% product.included.forEach(item => { %><span><%= item %></span><% }) %>
        </div>
      </section>

      <section class="detail-block preview-grid">
        <h2>Xem trước tài nguyên</h2>
        <div><span>Thư viện prompt</span><strong>120+</strong></div>
        <div><span>Trang template</span><strong>24</strong></div>
        <div><span>Hướng dẫn setup</span><strong>Video</strong></div>
      </section>

      <section class="detail-block">
        <h2>Changelog</h2>
        <ol class="changelog">
          <% product.changelog.forEach(item => { %><li><%= item %></li><% }) %>
        </ol>
      </section>

      <section class="detail-block">
        <h2>FAQ</h2>
        <% shop.faqs.slice(0, 3).forEach(item => { %>
          <details class="faq-item"><summary><%= item.q %></summary><p><%= item.a %></p></details>
        <% }) %>
      </section>

      <section class="detail-block">
        <h2>Related products</h2>
        <div class="product-grid product-grid--related">
          <% related.forEach(item => { %>
            <%- include('./partials/product-card', { product: item }) %>
          <% }) %>
        </div>
      </section>
    </article>

    <aside class="purchase-box">
      <span class="eyebrow"><%= product.access %></span>
      <h2><%= product.priceText %></h2>
      <% if (product.compareAt) { %><p class="compare-price"><%= product.compareAt.toLocaleString('vi-VN') %>d</p><% } %>
      <% if (product.limited) { %>
        <div class="mini-countdown" data-countdown="2026-06-01T23:59:59+07:00">
          <span>Đợt mở bán giới hạn</span>
          <strong data-countdown-label>Đang tính...</strong>
        </div>
      <% } %>
      <label class="qty-field">Số lượng <input type="number" value="1" min="1" /></label>
      <label class="coupon-field">Coupon <input placeholder="HS-AI" /></label>
      <button class="btn btn--primary" data-buy-now data-slug="<%= product.slug %>">Mua ngay</button>
      <button class="btn btn--ghost" data-add-cart data-slug="<%= product.slug %>">Thêm vào giỏ</button>
      <button class="btn btn--soft" data-favorite>Yêu thích</button>
      <div class="purchase-notes">
        <span>Truy cập tức thì</span>
        <span>Sẵn sàng xuất hoá đơn</span>
        <span>Có upsell consulting</span>
      </div>
    </aside>
  </section>
</main>

<div class="mobile-buy-bar">
  <strong><%= product.priceText %></strong>
  <button class="btn btn--primary" data-add-cart data-slug="<%= product.slug %>">Thêm vào giỏ</button>
</div>

<%- include('./partials/footer', { shop }) %>
</body>
</html>
