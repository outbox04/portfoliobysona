<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<%- include('./partials/head', {
  title: 'Cart | HS Marketing & AI Shop',
  description: 'Quản lý giỏ hàng digital products, coupon và checkout.',
  canonical: '/cart',
  siteUrl
}) %>
<body class="shop-page">
<%- include('./partials/nav') %>

<main>
  <section class="sub-hero sub-hero--compact">
    <span class="eyebrow">Cart</span>
    <h1>Giỏ hàng của bạn</h1>
    <p>Apple-style clean checkout cho digital product, template và membership.</p>
  </section>

  <section class="cart-layout">
    <div class="cart-list" data-cart-list>
      <div class="empty-state">
        <h2>Giỏ hàng đang trống</h2>
        <p>Chọn một product trong shop để bắt đầu.</p>
        <a class="btn btn--primary" href="/shop">Về shop</a>
      </div>
    </div>
    <aside class="summary-card" data-cart-summary>
      <h2>Order Summary</h2>
      <label>Coupon <input data-coupon-input placeholder="HS-AI" /></label>
      <div><span>Subtotal</span><strong data-subtotal>0d</strong></div>
      <div><span>VAT</span><strong data-vat>0d</strong></div>
      <div class="summary-total"><span>Total</span><strong data-total>0d</strong></div>
      <a class="btn btn--primary" href="/checkout">Thanh toán ngay</a>
    </aside>
  </section>
</main>

<%- include('./partials/footer', { shop }) %>
</body>
</html>
