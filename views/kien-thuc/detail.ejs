<!DOCTYPE html>
<html lang="vi" data-theme="dark" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= article.title %> — Trần Hồng Sơn</title>
  <meta name="description" content="<%= article.short %>" />
  <link rel="canonical" href="<%= siteUrl %>/kien-thuc/<%= article.id %>" />
  <meta property="og:type"        content="article" />
  <meta property="og:url"         content="<%= siteUrl %>/kien-thuc/<%= article.id %>" />
  <meta property="og:title"       content="<%= article.title %>" />
  <meta property="og:description" content="<%= article.short %>" />
  <meta property="og:image"       content="<%= siteUrl %><%= article.thumb %>" />
  <meta property="og:locale"      content="vi_VN" />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:title"      content="<%= article.title %>" />
  <meta name="twitter:image"      content="<%= siteUrl %><%= article.thumb %>" />
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/kien-thuc.css" />
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="cursorFollower"></div>

<nav class="nav scrolled" id="nav">
  <a href="/" class="nav__logo">HS<span>.</span></a>
  <div class="nav__right">
    <ul class="nav__links" id="navLinks">
      <li><a href="#about"      class="nav__link">Giới thiệu</a></li>
      <li><a href="#skills"     class="nav__link">Kỹ năng</a></li>
      <li><a href="#experience" class="nav__link">Kinh nghiệm</a></li>
      <li><a href="#projects"   class="nav__link">Dự án</a></li>
      <li><a href="/ecosystem" class="nav__link">Ecosystem</a></li>
      <li><a href="/kien-thuc" class="nav__link">Kiến thức</a></li>
      <li><a href="#contact"    class="nav__link">Liên hệ</a></li>
    </ul>
    <button class="theme-toggle" id="themeToggle" aria-label="Chuyển giao diện">
      <span class="theme-toggle__icon moon">🌙</span>
      <span class="theme-toggle__icon sun">☀️</span>
    </button>
    <button class="nav__toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- ARTICLE HERO -->
<section class="art-hero">
  <div class="container">
    <div class="art-hero__back reveal-up">
      <a href="/kien-thuc" class="btn btn--back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Quay lại
      </a>
    </div>
    <div class="art-hero__meta reveal-up">
      <span class="art-type <%= article.type %>">
        <%= article.type === 'news' ? '📰 Tin tức' : '📚 Kiến thức' %>
      </span>
      <span class="art-cat"><%= article.cat %></span>
    </div>
    <h1 class="art-hero__title reveal-up"><%= article.title %></h1>
    <p class="art-hero__desc reveal-up"><%= article.short %></p>
    <div class="art-hero__info reveal-up">
      <span>🗓 <%= article.date %></span>
      <span>⏱ <%= article.readTime %></span>
      <span>✍️ Trần Hồng Sơn</span>
    </div>
  </div>
</section>

<!-- COVER -->
<div class="container">
  <img src="<%= article.thumb %>" alt="<%= article.title %>"
    class="art-cover reveal-scale"
    onerror='this.style.background="var(--bg-4)";this.src=""' />
</div>

<!-- ARTICLE BODY -->
<section class="art-body">
  <div class="container">
    <div class="art-layout">

      <!-- CONTENT -->
      <article class="art-content reveal-up">
        <%- article.content %>
      </article>

      <!-- SIDEBAR -->
      <aside class="art-sidebar">

        <!-- Share -->
        <div class="art-widget reveal-right">
          <h3>Chia sẻ bài viết</h3>
          <div class="art-share">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= siteUrl %>/kien-thuc/<%= article.id %>"
              target="_blank" rel="noopener" class="share-btn facebook">
              📘 Facebook
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= siteUrl %>/kien-thuc/<%= article.id %>"
              target="_blank" rel="noopener" class="share-btn linkedin">
              💼 LinkedIn
            </a>
            <button class="share-btn copy" onclick="navigator.clipboard.writeText(window.location.href);this.textContent='✅ Đã copy!'">
              🔗 Copy link
            </button>
          </div>
        </div>

        <!-- Related -->
        <% if (related && related.length > 0) { %>
        <div class="art-widget reveal-right">
          <h3>Bài viết liên quan</h3>
          <div class="art-related">
            <% related.forEach(function(r) { %>
            <a href="/kien-thuc/<%= r.id %>" class="art-related__item">
              <div class="art-related__img">
                <img src="<%= r.thumb %>" alt="<%= r.title %>"
                  onerror='this.parentElement.classList.add("no-img");this.style.display="none"'
                  loading="lazy" />
              </div>
              <div>
                <span class="art-related__cat"><%= r.cat %></span>
                <p><%= r.title %></p>
              </div>
            </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- CTA -->
        <div class="art-widget art-cta-widget reveal-right">
          <p>Muốn áp dụng kiến thức này vào doanh nghiệp?</p>
          <a href="/#contact" class="btn btn--primary" style="width:100%;justify-content:center">
            Liên hệ tư vấn
          </a>
        </div>

      </aside>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <p>© 2026 Trần Hồng Sơn — Marketing Portfolio</p>
    <p class="footer__sub">portfoliobyson.site</p>
  </div>
</footer>

<script src="/js/main.js"></script>
<script src="/js/kien-thuc.js"></script>
<script defer src="/_vercel/insights/script.js"></script>
</body>
</html>
