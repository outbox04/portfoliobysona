<!DOCTYPE html>
<html lang="vi" data-theme="dark" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="oslR3uifvKwjMiKD_EG35RhJWvAJMG0XFUkim_wwfsk" />
  <meta name="dmca-site-verification" content="NFhhMTVHc3BWL3lzdDNKYWFKdEJZWTA2QUpMNmJ3L1lKNEJmUTJmeEJQaz01" />
  <title><%= article.title %> — Trần Hồng Sơn</title>
  <meta name="description" content="<%= article.short %>" />
  <link rel="canonical" href="<%= siteUrl %>/kien-thuc/<%= article.id %>" />
  <meta property="og:type"        content="article" />
  <meta property="og:url"         content="<%= siteUrl %>/kien-thuc/<%= article.id %>" />
  <meta property="og:title"       content="<%= article.title %>" />
  <meta property="og:description" content="<%= article.short %>" />
  <meta property="og:image"       content="<%= siteUrl %><%= article.ogImage ? article.ogImage : article.thumb %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="<%= article.title %>" />
  <meta property="og:site_name"   content="Trần Hồng Sơn - Marketing Portfolio" />
  <meta property="og:locale"      content="vi_VN" />
  <meta property="article:author" content="Trần Hồng Sơn" />
  <meta property="article:section" content="<%= article.cat %>" />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:url"        content="<%= siteUrl %>/kien-thuc/<%= article.id %>" />
  <meta name="twitter:title"      content="<%= article.title %>" />
  <meta name="twitter:description" content="<%= article.short %>" />
  <meta name="twitter:image"      content="<%= siteUrl %><%= article.ogImage ? article.ogImage : article.thumb %>" />
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/kien-thuc.css" />

  <link rel="preload" as="image" href="<%= article.thumb %>" />

  <!-- Schema Markup (JSON-LD) for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "<%= article.type === 'news' ? 'NewsArticle' : 'Article' %>",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "<%= siteUrl %>/kien-thuc/<%= article.id %>"
    },
    "headline": "<%= article.title %>",
    "description": "<%= article.short %>",
    "image": "<%= siteUrl %><%= article.ogImage ? article.ogImage : article.thumb %>",
    "author": {
      "@type": "Person",
      "name": "Trần Hồng Sơn",
      "url": "<%= siteUrl %>"
    }
  }
  </script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7REC4SW5DB"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-7REC4SW5DB');
  </script>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="cursorFollower"></div>

<nav class="nav scrolled" id="nav">
  <a href="/" class="nav__logo">HS<span>.</span></a>
  <div class="nav__right">
    <ul class="nav__links" id="navLinks">
      <li><a href="/#about"      class="nav__link">Giới thiệu</a></li>
      <li><a href="/#skills"     class="nav__link">Kỹ năng</a></li>
      <li><a href="/#experience" class="nav__link">Kinh nghiệm</a></li>
      <li><a href="/#projects"   class="nav__link">Dự án</a></li>
      <li><a href="/kien-thuc"   class="nav__link active-link">Kiến thức</a></li>
      <li><a href="/growth-roadmap" class="nav__link">Roadmap</a></li>
      <li><a href="/#contact"    class="nav__link">Liên hệ</a></li>
    </ul>
    <button class="theme-toggle" id="themeToggle" aria-label="Chuyển giao diện">
      <span class="theme-toggle__icon moon">🌙</span>
      <span class="theme-toggle__icon sun">☀️</span>
    </button>
    <button class="nav__toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- ARTICLE HERO -->
<section class="art-hero">
  <div class="container">
    <div class="art-hero__back reveal-up">
      <a href="/kien-thuc" class="btn btn--back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Quay lại
      </a>
    </div>
    <div class="art-hero__meta reveal-up">
      <span class="art-type <%= article.type %>">
        <%= article.type === 'news' ? '📰 Tin tức' : '📚 Kiến thức' %>
      </span>
      <span class="art-cat"><%= article.cat %></span>
    </div>
    <h1 class="art-hero__title reveal-up"><%= article.title %></h1>
    <p class="art-hero__desc reveal-up"><%= article.short %></p>
    <div class="art-hero__info reveal-up">
      <span>🗓 <%= article.date %></span>
      <span>⏱ <%= article.readTime %></span>
      <span>✍️ Trần Hồng Sơn</span>
    </div>
  </div>
</section>

<!-- COVER -->
<div class="container">
  <img src="<%= article.thumb %>" alt="<%= article.title %>"
    class="art-cover reveal-scale"
    fetchpriority="high"
    onerror='this.style.background="var(--bg-4)";this.src=""' />
</div>

<!-- ARTICLE BODY -->
<section class="art-body">
  <div class="container">
    <div class="art-layout">

      <!-- CONTENT -->
      <article class="art-content reveal-up">
        <%- article.content %>
      </article>

      <!-- SIDEBAR -->
      <aside class="art-sidebar">

        <!-- Share -->
        <div class="art-widget reveal-right">
          <h3>Chia sẻ bài viết</h3>
          <div class="art-share">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= siteUrl %>/kien-thuc/<%= article.id %>"
              target="_blank" rel="noopener" class="share-btn facebook">
              📘 Facebook
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= siteUrl %>/kien-thuc/<%= article.id %>"
              target="_blank" rel="noopener" class="share-btn linkedin">
              💼 LinkedIn
            </a>
          </div>
        </div>

        <!-- Related -->
        <% if (related && related.length > 0) { %>
        <div class="art-widget reveal-right">
          <h3>Bài viết liên quan</h3>
          <div class="art-related">
            <% related.forEach(function(r) { %>
            <a href="/kien-thuc/<%= r.id %>" class="art-related__item">
              <div class="art-related__img">
                <img src="<%= r.thumb %>" alt="<%= r.title %>"
                  onerror='this.parentElement.classList.add("no-img");this.style.display="none"'
                  loading="lazy" />
              </div>
              <div>
                <span class="art-related__cat"><%= r.cat %></span>
                <p><%= r.title %></p>
              </div>
            </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <!-- CTA -->
        <div class="art-widget art-cta-widget reveal-right">
          <p>Muốn áp dụng kiến thức này vào doanh nghiệp?</p>
          <a href="/#contact" class="btn btn--primary" style="width:100%;justify-content:center">
            Liên hệ tư vấn
          </a>
        </div>

      </aside>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div style="margin-bottom: 16px; display: flex; justify-content: center;">
      <a href="//www.dmca.com/Protection/Status.aspx?ID=ef2dde35-e56c-46cf-bcd9-e25455623e29" title="DMCA.com Protection Status" class="dmca-badge">
        <img src="https://images.dmca.com/Badges/dmca_protected_sml_120m.png?ID=ef2dde35-e56c-46cf-bcd9-e25455623e29" alt="DMCA.com Protection Status" />
      </a>
    </div>
    <p>© 2026 Trần Hồng Sơn — Marketing Portfolio</p>
  </div>
</footer>

<script src="https://images.dmca.com/Badges/DMCABadgeHelper.min.js"></script>
<script src="/js/main.js" defer></script>
<script src="/js/kien-thuc.js" defer></script>
<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/_vercel/speed-insights/script.js"></script>
</body>
</html>
