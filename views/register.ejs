<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Đăng ký quản trị | Portfolio</title>
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v=20260527-brief-submit-align" />
  <link rel="stylesheet" href="/css/login.css?v=20260527-password-strength" />
</head>
<body class="login-page">
  <main class="login-shell">
    <section class="login-panel" aria-labelledby="registerTitle">
      <a class="login-brand" href="/" aria-label="Về trang chủ">HS<span>.</span></a>
      <p class="login-kicker">Project Admin</p>
      <h1 id="registerTitle">Đăng ký tài khoản quản trị</h1>
      <p class="login-copy">Tạo tài khoản để truy cập khu vực quản trị dự án. Tài khoản có thể cần được kích hoạt trước khi đăng nhập.</p>

      <% if (error) { %>
        <div class="login-alert" role="alert"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="login-alert login-alert--success" role="status"><%= success %></div>
      <% } %>

      <form class="login-form" action="/register" method="POST" autocomplete="on">
        <label>
          Họ tên
          <input name="fullName" type="text" autocomplete="name" placeholder="Nhập họ tên" />
        </label>
        <label>
          Email
          <input name="email" type="email" autocomplete="email" placeholder="Nhập email" />
        </label>
        <label>
          Tài khoản
          <input name="username" type="text" autocomplete="username" placeholder="Tạo tài khoản đăng nhập" required autofocus />
        </label>
        <label>
          Mật khẩu
          <input id="registerPassword" name="password" type="password" autocomplete="new-password" placeholder="Tạo mật khẩu" required />
        </label>
        <div class="password-rules" id="passwordRules" aria-live="polite">
          <p data-rule="length">8 k? t? tr? l�n</p>
          <p data-rule="uppercase">�t nh?t 1 k? t? in hoa</p>
          <p data-rule="lowercase">�t nh?t 1 ch? th�?ng</p>
          <p data-rule="special">�t nh?t 1 k? t? �?c bi?t</p>
        </div>
        <label>
          Xác nhận mật khẩu
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required />
        </label>
        <p class="password-match" id="passwordMatch" aria-live="polite"></p>
        <button class="btn btn--primary login-submit" type="submit">Đăng ký</button>
      </form>

      <p class="auth-switch">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
    </section>
  </main>
  <script src="/js/register.js?v=20260527-password-strength" defer></script>
</body>
</html>
