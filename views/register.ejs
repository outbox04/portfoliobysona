<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>&#272;&#259;ng k&#253; qu&#7843;n tr&#7883; | Portfolio</title>
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" /></noscript>
  <link rel="stylesheet" href="/css/style.css?v=20260527-brief-submit-align" />
  <link rel="stylesheet" href="/css/login.css?v=20260527-auth-pass-toggle" />
</head>
<body class="login-page">
  <main class="login-shell">
    <section class="auth-card auth-card--register" aria-labelledby="registerTitle">
      <aside class="auth-visual" aria-label="Project Admin">
        <a class="auth-logo" href="/" aria-label="V&#7873; trang ch&#7911;">
          <span>HS</span>
        </a>
        <h2>Create Account</h2>
        <p>T&#7841;o quy&#7873;n truy c&#7853;p v&#224;o kh&#244;ng gian qu&#7843;n tr&#7883; portfolio.</p>
        <a class="auth-ghost" href="/login">&#272;&#259;ng nh&#7853;p</a>
      </aside>

      <section class="login-panel auth-form-panel">
        <p class="login-kicker">Project Admin</p>
        <h1 id="registerTitle">welcome</h1>
        <p class="login-copy">Sign up to continue with your admin account</p>

        <% if (error) { %>
          <div class="login-alert" role="alert"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="login-alert login-alert--success" role="status"><%= success %></div>
        <% } %>

        <form class="login-form" action="/register" method="POST" autocomplete="on">
          <label>
            <span>H&#7885; t&#234;n</span>
            <input name="fullName" type="text" autocomplete="name" placeholder="Full name" />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" placeholder="Email" />
          </label>
          <label>
            <span>T&#224;i kho&#7843;n</span>
            <input name="username" type="text" autocomplete="username" placeholder="Username" required autofocus />
          </label>
          <label>
            <span>M&#7853;t kh&#7849;u</span>
            <div class="password-field">
              <input id="registerPassword" name="password" type="password" autocomplete="new-password" placeholder="Password" required />
              <button class="password-toggle" type="button" aria-label="Hi&#7879;n m&#7853;t kh&#7849;u" aria-pressed="false">
                <svg class="password-toggle__eye" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="password-toggle__eye-off" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6a17.1 17.1 0 0 1-2.3 2.8M15 17.4A9.9 9.9 0 0 1 12 18c-6 0-9.5-6-9.5-6a16.8 16.8 0 0 1 4.1-4.2"></path>
                  <path d="M9.9 9.9A3 3 0 0 0 14.1 14.1"></path>
                  <path d="M4 4l16 16"></path>
                </svg>
              </button>
            </div>
          </label>
          <div class="password-rules" id="passwordRules" aria-live="polite">
            <p data-rule="length">8 k&#253; t&#7921; tr&#7903; l&#234;n</p>
            <p data-rule="uppercase">&#205;t nh&#7845;t 1 k&#253; t&#7921; in hoa</p>
            <p data-rule="lowercase">&#205;t nh&#7845;t 1 ch&#7919; th&#432;&#7901;ng</p>
            <p data-rule="special">&#205;t nh&#7845;t 1 k&#253; t&#7921; &#273;&#7863;c bi&#7879;t</p>
          </div>
          <label>
            <span>X&#225;c nh&#7853;n m&#7853;t kh&#7849;u</span>
            <div class="password-field">
              <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password" required />
              <button class="password-toggle" type="button" aria-label="Hi&#7879;n m&#7853;t kh&#7849;u" aria-pressed="false">
                <svg class="password-toggle__eye" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="password-toggle__eye-off" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6a17.1 17.1 0 0 1-2.3 2.8M15 17.4A9.9 9.9 0 0 1 12 18c-6 0-9.5-6-9.5-6a16.8 16.8 0 0 1 4.1-4.2"></path>
                  <path d="M9.9 9.9A3 3 0 0 0 14.1 14.1"></path>
                  <path d="M4 4l16 16"></path>
                </svg>
              </button>
            </div>
          </label>
          <p class="password-match" id="passwordMatch" aria-live="polite"></p>
          <button class="login-submit" type="submit">SIGN UP</button>
        </form>

        <p class="auth-switch">Already have an account? <a href="/login">sign in</a></p>
      </section>
    </section>
  </main>
  <script src="/js/auth.js?v=20260527-auth-pass-toggle" defer></script>
  <script src="/js/register.js?v=20260527-auth-pass-toggle" defer></script>
</body>
</html>
