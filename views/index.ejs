        <div class="contact-console__actions">
          <button class="btn btn--primary contact-brief-btn" type="button" data-brief-open>Gửi brief dự án</button>
        </div>
      </div>

      <div class="contact__grid">
        <a href="tel:0987603615" class="contact-item">
          <div class="contact-icon">📞</div>
