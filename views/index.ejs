<div class="brief-modal" id="briefModal" aria-hidden="true">
  <div class="brief-modal__overlay" data-brief-close></div>
  <div class="brief-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="briefTitle">
    <button class="brief-modal__close" type="button" aria-label="Đóng form brief" data-brief-close>×</button>
    <div class="brief-modal__head">
      <p class="section-label">Brief dự án</p>
      <h3 id="briefTitle">Thông tin để lên phương án triển khai</h3>
      <p>Điền nhanh bối cảnh thương hiệu, sản phẩm và mong muốn. Nội dung sẽ được gửi trực tiếp để tôi phản hồi sớm nhất.</p>
    </div>
    <form class="brief-form" id="briefForm">
      <label>
        Tên thương hiệu
        <input name="brand" type="text" placeholder="VD: Nội thất Sơn Tùng" required />
      </label>
      <label>
        Sản phẩm / dịch vụ chính
        <input name="product" type="text" placeholder="VD: Thiết kế và thi công nội thất" required />
      </label>
      <label>
        Website / Fanpage
        <input name="channel" type="text" placeholder="Link website, Facebook, TikTok..." />
      </label>
      <label>
        Ngân sách dự kiến
        <input name="budget" type="text" placeholder="VD: 20-50 triệu/tháng" />
      </label>
      <fieldset>
        <legend>Mong muốn triển khai</legend>
        <div class="brief-checks">
          <label><input type="checkbox" name="goals" value="Phát triển Branding" /> Phát triển Branding</label>
          <label><input type="checkbox" name="goals" value="Performance Ads" /> Performance Ads</label>
          <label><input type="checkbox" name="goals" value="Content/Social Media" /> Content/Social Media</label>
          <label><input type="checkbox" name="goals" value="Thiết kế hình ảnh" /> Thiết kế hình ảnh</label>
          <label><input type="checkbox" name="goals" value="Video Production" /> Video Production</label>
          <label><input type="checkbox" name="goals" value="AI/Automation" /> AI/Automation</label>
        </div>
      </fieldset>
      <label class="brief-form__wide">
        Thông tin chi tiết và kỳ vọng
        <textarea name="detail" rows="5" placeholder="Mục tiêu kinh doanh, vấn đề đang gặp, thị trường, đối thủ, timeline mong muốn..." required></textarea>
      </label>
      <button class="btn btn--primary brief-form__submit" type="submit">Gửi Brief</button>
    </form>
  </div>
</div>

<div class="brief-toast" id="briefToast" aria-live="polite" aria-hidden="true">
  <div class="brief-toast__dialog" role="status">
    <div class="brief-toast__icon" id="briefToastIcon">✓</div>
    <div>
      <strong id="briefToastTitle">Đã gửi brief</strong>
      <p id="briefToastMessage">Cảm ơn bạn. Tôi sẽ phản hồi trong thời gian sớm nhất.</p>
    </div>
  </div>
</div>

<!-- DOWNLOAD CV -->
<section class="download-cv">
  <div class="container">
    <div class="download-cv__inner reveal-up">
      <div class="download-cv__text">
        <h3>Tải CV của tôi</h3>
        <p>Xem đầy đủ kinh nghiệm và thành tích trong file CV</p>
      </div>
      <a href="/download-cv" class="btn btn--download">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Tải xuống CV
      </a>
    </div>
  </div>
</section>

