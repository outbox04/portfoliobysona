  <meta name="dmca-site-verification" content="NFhhMTVHc3BWL3lzdDNKYWFKdEJZWTA2QUpMNmJ3L1lKNEJmUTJmeEJQaz01" />
  <title>Prompt Content OS - Content Prompt Builder</title>
  <meta name="description" content="AI Content & Creative Operating System: tạo content, giải thích psychology, dựng visual social-ready trong portfolio Trần Hồng Sơn." />
  <link rel="canonical" href="<%= siteUrl %>/content-os" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= siteUrl %>/content-os" />
  <meta property="og:site_name" content="Trần Hồng Sơn Portfolio" />
  <meta property="og:title" content="Prompt Content OS - Content Prompt Builder" />
  <meta property="og:description" content="Workflow tạo content, psychology và visual social-ready cho thương hiệu." />
  <meta property="og:image" content="<%= siteUrl %>/images/og/content-os.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Prompt Content OS - AI content workflow" />
  <meta property="og:locale" content="vi_VN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Prompt Content OS - Content Prompt Builder" />
  <meta name="twitter:description" content="Workflow tạo content, psychology và visual social-ready cho thương hiệu." />
  <meta name="twitter:image" content="<%= siteUrl %>/images/og/content-os.jpg" />
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/content-os.css" />
</head>
<body class="content-os-page">

<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="cursorFollower"></div>

<nav class="nav scrolled" id="nav">
  <a href="/" class="nav__logo">HS<span>.</span></a>
  <div class="nav__right">
    <ul class="nav__links" id="navLinks">
      <li><a href="/" class="nav__link">Trang chủ</a></li>
      <li><a href="/#projects" class="nav__link">Dự án</a></li>
      <li><a href="/ecosystem" class="nav__link">Ecosystem</a></li>
      <li><a href="/content-os" class="nav__link active-link">Content OS</a></li>
      <li><a href="/kien-thuc" class="nav__link">Kiến thức</a></li>
      <li><a href="/growth-roadmap" class="nav__link">Roadmap</a></li>
      <li><a href="/#contact" class="nav__link">Liên hệ</a></li>
    </ul>
    <button class="theme-toggle" id="themeToggle" aria-label="Chuyển giao diện">
      <span class="theme-toggle__icon moon">🌙</span>
      <span class="theme-toggle__icon sun">☀️</span>
    </button>
    <button class="nav__toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<main class="cos-shell">
  <section class="cos-topbar">
    <div>
      <p class="cos-kicker">Prompt Creative Lab</p>
      <h1>Prompt Content OS</h1>
      <p>Input thương hiệu, chọn chiến lược, generate content có psychology và visual social-ready.</p>
    </div>
    <div class="cos-flow" aria-label="Workflow">
      <span>Input</span>
      <span>Prompt</span>
      <span>Output</span>
      <span>Export</span>
    </div>
  </section>

  <section class="cos-dev-notice" aria-label="Thông báo trạng thái Content OS">
    <div>
      <span class="cos-dev-notice__eyebrow">Đang phát triển</span>
      <h2>Phần này đang trong quá trình phát triển</h2>
      <p>Content OS hiện được khôi phục ở chế độ Prompt Builder cục bộ. Khi có API, phần tạo content và visual sẽ được tích hợp trực tiếp để sử dụng ngay trên website.</p>
    </div>
    <span class="cos-dev-notice__status">No API mode</span>
  </section>

  <section class="cos-workspace">
    <aside class="cos-panel cos-input-panel" aria-label="Input system">
      <div class="cos-panel__head">
        <div>
          <span class="cos-step">01</span>
          <h2>Input System</h2>
        </div>
        <button class="cos-icon-btn" type="button" id="resetBtn" title="Reset input">Reset</button>
      </div>

      <form id="contentForm" class="cos-form">
        <details class="cos-group" open>
          <summary>Upload</summary>
          <label class="cos-upload" for="assetUpload">
            <input id="assetUpload" name="assets" type="file" accept="image/*" multiple />
            <span>Upload logo, sản phẩm, người, moodboard</span>
          </label>
          <div class="cos-upload-list" id="uploadList"></div>
        </details>

        <details class="cos-group" open>
          <summary>Brand Information</summary>
          <label>Tên thương hiệu <input name="brandName" value="Studio Sơn" placeholder="VD: Studio Sơn" /></label>
          <label>Slogan <input name="slogan" value="Build content that sells quietly" placeholder="Brand slogan" /></label>
          <label>Ngành nghề <input name="industry" value="Marketing & Creative Services" placeholder="Ngành nghề" /></label>
          <label>Mô tả thương hiệu <textarea name="brandDesc" rows="3" placeholder="Thương hiệu của bạn làm gì, khác biệt ở đâu?">Dịch vụ giúp SME biến insight khách hàng thành content rõ ràng, đẹp và có khả năng chuyển đổi.</textarea></label>
          <label>Core value <input name="coreValue" value="Rõ ràng, thẩm mỹ, thực chiến" placeholder="3-5 giá trị cốt lõi" /></label>
          <label>Brand voice <input name="brandVoice" value="Thẳng, ấm, có chiều sâu" placeholder="Giọng thương hiệu" /></label>
        </details>

        <details class="cos-group">
          <summary>Audience Information</summary>
          <label>Khách hàng mục tiêu <textarea name="audience" rows="2">Chủ doanh nghiệp nhỏ, founder và marketing executive cần hệ thống content chuyên nghiệp.</textarea></label>
          <label>Pain points <textarea name="painPoints" rows="2">Content rời rạc, hình ảnh thiếu đồng bộ, đăng nhiều nhưng không tạo niềm tin.</textarea></label>
          <label>Aspiration <textarea name="aspiration" rows="2">Muốn thương hiệu nhìn chuyên nghiệp hơn và tạo lead đều hơn.</textarea></label>
          <label>Nhu cầu <input name="needs" value="Một workflow content dễ triển khai hằng tuần" /></label>
          <label>Mục tiêu tâm lý <input name="psychGoal" value="Tạo cảm giác được thấu hiểu và có lối ra rõ ràng" /></label>
        </details>

        <details class="cos-group" open>
          <summary>Content Strategy</summary>
          <label>Nền tảng
            <select name="platform">
              <option>Facebook</option>
              <option>Threads</option>
              <option>LinkedIn</option>
              <option>TikTok</option>
              <option>Instagram</option>
            </select>
          </label>
          <label>Tone
            <select name="tone">
              <option>storytelling</option>
              <option>phản biện nhẹ</option>
              <option>luxury</option>
              <option>authority</option>
              <option>emotional</option>
              <option>viral</option>
              <option>educational</option>
              <option>minimal</option>
            </select>
          </label>
          <div class="cos-grid-2">
            <label>Công thức
              <select name="formula">
                <option>AIDA</option>
                <option>PAS</option>
                <option>BAB</option>
                <option>ACCA</option>
                <option>SSS</option>
              </select>
            </label>
            <label>Mục tiêu
              <select name="goal">
                <option>branding</option>
                <option>conversion</option>
                <option>engagement</option>
                <option>viral</option>
                <option>leads</option>
              </select>
            </label>
            <label>CTA type
              <select name="ctaType">
                <option>soft sell</option>
                <option>hard sell</option>
                <option>trust-building</option>
                <option>conversation</option>
              </select>
            </label>
            <label>Hook type
              <select name="hookType">
                <option>curiosity</option>
                <option>contrarian</option>
                <option>emotional</option>
                <option>authority</option>
                <option>storytelling</option>
              </select>
            </label>
          </div>
        </details>

        <details class="cos-group" open>
          <summary>Visual Output</summary>
          <div class="cos-grid-2">
            <label>Output type
              <select name="visualType">
                <option>single image</option>
                <option>no image</option>
                <option>multi-image</option>
                <option>carousel</option>
                <option>story</option>
              </select>
            </label>
            <label>Số ảnh
              <input name="imageCount" type="number" min="1" max="5" value="5" />
            </label>
            <label>Export size
              <select name="exportSize">
                <option value="1:1">1:1</option>
                <option value="4:5">4:5</option>
                <option value="9:16">9:16</option>
                <option value="carousel">carousel</option>
              </select>
            </label>
            <label>Brand color
              <input name="brandColor" type="color" value="#e63022" />
            </label>
          </div>
        </details>

        <button class="cos-generate" type="submit">Build Prompt + Preview</button>
      </form>
    </aside>

    <section class="cos-panel cos-output-panel" aria-label="Prompt content output">
      <div class="cos-panel__head">
        <div>
          <span class="cos-step">02</span>
          <h2>Prompt & Content Output</h2>
        </div>
        <button class="cos-icon-btn" type="button" id="copyBtn">Copy clean content</button>
      </div>

      <div class="cos-output" id="contentOutput">
        <div class="cos-empty">
          <span>Content + Explanation + Psychology</span>
          <p>Nhấn Generate để tạo bản content đầu tiên. Input sẽ được giữ nguyên cho tới khi reload hoặc bấm Reset.</p>
        </div>
      </div>
      <div class="cos-prompt-box">
        <div class="cos-prompt-head">
          <span>Prompt Builder</span>
          <button class="cos-icon-btn" type="button" id="copyPromptBtn">Copy prompt</button>
        </div>
        <textarea id="promptOutput" readonly placeholder="Prompt chuẩn sẽ xuất hiện sau khi bấm Build Prompt + Preview."></textarea>
      </div>
      <div class="cos-prompt-box">
        <div class="cos-prompt-head">
          <span>Paste AI Result</span>
          <button class="cos-icon-btn" type="button" id="applyResultBtn">Apply JSON</button>
        </div>
        <textarea id="aiResultInput" placeholder="Dán JSON từ ChatGPT/Gemini web vào đây nếu muốn render lại output theo kết quả AI."></textarea>
      </div>
    </section>

    <aside class="cos-panel cos-visual-panel" aria-label="Visual engine">
      <div class="cos-panel__head">
        <div>
          <span class="cos-step">03</span>
          <h2>Visual Engine</h2>
        </div>
        <div class="cos-panel__actions">
          <button class="cos-icon-btn" type="button" id="exportBtn">Export PNG</button>
        </div>
      </div>

      <div class="cos-brand-strip">
        <span>Brand sync</span>
        <div class="cos-swatches" id="swatches"></div>
      </div>

      <div class="cos-visual-list" id="visualOutput">
        <div class="cos-visual-card is-empty">
          <span>HOOK</span>
          <strong>Visual preview sẽ xuất hiện ở đây</strong>
          <p>Typography, màu logo và content hierarchy được render bằng frontend.</p>
        </div>
      </div>
    </aside>
  </section>
</main>

<div style="margin: 24px 0; display: flex; justify-content: center;">
  <a href="//www.dmca.com/Protection/Status.aspx?ID=ef2dde35-e56c-46cf-bcd9-e25455623e29" title="DMCA.com Protection Status" class="dmca-badge">
    <img src="https://images.dmca.com/Badges/dmca_protected_sml_120m.png?ID=ef2dde35-e56c-46cf-bcd9-e25455623e29" alt="DMCA.com Protection Status" />
  </a>
</div>

<script src="https://images.dmca.com/Badges/DMCABadgeHelper.min.js"></script>
<script src="/js/main.js"></script>
<script src="/js/content-os.js"></script>
</body>
</html>
