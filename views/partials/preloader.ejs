<!-- ═══════════════════════════════════════════════
     PRELOADER — MARKETER RUNNING LOADER
     Paste this as FIRST element inside <body>
═══════════════════════════════════════════════ -->
<div id="preloader">

  <!-- Background layers -->
  <div class="pre-bg">
    <div class="pre-blob pre-blob-1"></div>
    <div class="pre-blob pre-blob-2"></div>
    <div class="pre-blob pre-blob-3"></div>
  </div>

  <!-- Finish flash overlay -->
  <div class="pre-finish-flash" id="preFinishFlash"></div>

  <!-- Main content -->
  <div class="pre-content">

    <!-- Top label -->
    <div class="pre-label">Portfolio System</div>

    <!-- Headline -->
    <div class="pre-headline">
      <span class="pre-word">Initializing&nbsp;</span>
      <span class="pre-word pre-highlight">Marketing&nbsp;</span>
      <span class="pre-word">Ecosystem</span>
    </div>

    <!-- Track system -->
    <div class="pre-track-wrap">

      <!-- Percentage + Status -->
      <div class="pre-pct-row">
        <div>
          <span class="pre-pct" id="prePct">0</span><span class="pre-pct-sym">%</span>
        </div>
        <div class="pre-status">
          <span class="pre-status-line active" id="preStatus1">Loading assets</span>
          <span class="pre-status-line" id="preStatus2">Connecting modules</span>
        </div>
      </div>

      <!-- Runner area -->
      <div class="pre-runner-area">
        <div class="pre-runner" id="preRunner"></div>
      </div>

      <!-- Progress bar -->
      <div class="pre-bar-wrap">
        <div class="pre-bar-bg"></div>
        <div class="pre-bar-fill" id="preBarFill">
          <div class="pre-bar-tip" id="preBarTip"></div>
        </div>

        <!-- Checkpoints at 25, 50, 75, 100 -->
        <div class="pre-checkpoint" style="left:25%"  data-pct="25"></div>
        <div class="pre-checkpoint" style="left:50%"  data-pct="50"></div>
        <div class="pre-checkpoint" style="left:75%"  data-pct="75"></div>
        <div class="pre-checkpoint" style="left:100%" data-pct="100"></div>
      </div>

      <!-- Checkpoint labels -->
      <div class="pre-cp-labels">
        <span class="pre-cp-label passed" data-pct="0"   data-step="">Start</span>
        <span class="pre-cp-label"        data-pct="25"  data-step="01">Strategy</span>
        <span class="pre-cp-label"        data-pct="50"  data-step="02">Content</span>
        <span class="pre-cp-label"        data-pct="75"  data-step="03">Design</span>
        <span class="pre-cp-label"        data-pct="100" data-step="04">Launch</span>
      </div>

    </div><!-- end track-wrap -->

    <!-- Bottom tagline -->
    <div class="pre-tagline">Trần Hồng Sơn — Marketing Portfolio</div>

  </div><!-- end content -->
</div>
<!-- ═══ END PRELOADER ═══ -->
