<body class="roadmap-page">
<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="cursorFollower"></div>

<nav class="nav" id="nav">
  <a href="/" class="nav__logo">HS<span>.</span></a>
  <div class="nav__right">
    <ul class="nav__links" id="navLinks">
      <li><a href="/" class="nav__link">Trang chủ</a></li>
      <li><a href="/tran-hong-son" class="nav__link">About Me</a></li>
      <li><a href="/ecosystem" class="nav__link">Ecosystem</a></li>
      <li><a href="/content-os" class="nav__link">Content OS</a></li>
      <li><a href="/kien-thuc" class="nav__link">Kiến thức</a></li>
      <li><a href="/growth-roadmap" class="nav__link active-link">Roadmap</a></li>
    </ul>
    <button class="theme-toggle" id="themeToggle" aria-label="Chuyển giao diện">
      <span class="theme-toggle__icon moon">🌙</span>
      <span class="theme-toggle__icon sun">☀️</span>
    </button>
    <button class="nav__toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<main class="roadmap-shell">
  <section class="roadmap-hero" id="home">
    <div class="roadmap-hero__grid" aria-hidden="true"></div>
    <div class="roadmap-hero__particles" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="roadmap-hero__line" aria-hidden="true"></div>
    <div class="roadmap-hero__glow glow-a" aria-hidden="true"></div>
    <div class="roadmap-hero__glow glow-b" aria-hidden="true"></div>

    <div class="roadmap-hero__content">
      <p class="roadmap-kicker reveal-up">Marketing Roadmap</p>
      <h1 class="roadmap-hero__title reveal-up">
        <span>Đi đúng lộ trình.</span>
        <span>Lớn nhanh hơn.</span>
      </h1>
      <p class="roadmap-hero__sub reveal-up">Một bản đồ năng lực giúp marketer biết nên học gì, làm gì và nâng cấp khi nào.</p>

      <div class="roadmap-orbit reveal-up" aria-label="Tổng quan lộ trình">
        <div class="roadmap-orbit__core">
          <strong>5+</strong>
          <span>năm phát triển</span>
        </div>
        <div class="roadmap-orbit__ring" aria-hidden="true"></div>
        <div class="roadmap-orbit__item item-a">
          <span>01</span>
          <b>Foundation</b>
        </div>
        <div class="roadmap-orbit__item item-b">
          <span>03</span>
          <b>Specialist</b>
        </div>
        <div class="roadmap-orbit__item item-c">
          <span>06</span>
          <b>AI Era</b>
        </div>
      </div>

      <div class="roadmap-hero__actions reveal-up">
        <a href="#roadmap" class="roadmap-scroll">Xem roadmap</a>
        <span>Học đúng thứ, đúng giai đoạn.</span>
      </div>
    </div>
  </section>

  <section class="roadmap-section" id="roadmap">
    <div class="roadmap-section__head reveal-up">
      <p class="roadmap-kicker">Từ Beginner đến Manager</p>
      <h2>Lộ trình phát triển marketer</h2>
      <p>Đừng học đa nhiệm quá sớm. Mỗi giai đoạn cần một trọng tâm khác nhau: nền tảng, chuyên môn, hệ thống, con người và chiến lược.</p>
    </div>

    <div class="timeline">
      <div class="timeline__rail" aria-hidden="true"></div>

      <article class="road-level reveal-up">
        <div class="road-level__node">01</div>
        <div class="road-card">
          <div class="road-card__meta"><span>🌱 FOUNDATION</span><time>0 → 6 tháng</time></div>
          <h3>Nắm nền móng trước khi chọn tool</h3>
          <ul>
            <li>Marketing mindset</li>
            <li>Content cơ bản</li>
            <li>Social media</li>
            <li>Design cơ bản</li>
            <li>Hành vi khách hàng</li>
          </ul>
          <p class="road-goal">Goal: “Hiểu ngành Marketing vận hành thế nào.”</p>
          <div class="road-warning">❌ Đừng học tất cả tool cùng lúc.</div>
        </div>
      </article>

      <article class="road-level reveal-up">
        <div class="road-level__node">02</div>
        <div class="road-card road-card--wide">
          <div class="road-card__meta"><span>⚡ SPECIALIZATION</span><time>6 tháng → 2 năm</time></div>
          <h3>Chọn một nhánh để đi sâu</h3>
          <div class="skill-tree">
            <div class="skill-tree__root">Marketing</div>
            <button class="skill-branch active" data-path="Facebook Ads|Google Ads|Tracking|Conversion|Data">Performance</button>
            <button class="skill-branch" data-path="Brand Positioning|Identity|Messaging|Campaign|Brand Health">Branding</button>
            <button class="skill-branch" data-path="Insight|Hook|Script|Distribution|Content System">Content</button>
            <button class="skill-branch" data-path="Keyword|On-page|Technical|Content Cluster|Authority">SEO</button>
            <button class="skill-branch" data-path="Layout|Typography|Visual System|Creative Ads|Design Ops">Design</button>
            <div class="skill-roadmap" id="skillRoadmap" aria-live="polite"></div>
          </div>
        </div>
      </article>

      <article class="road-level reveal-up">
        <div class="road-level__node">03</div>
        <div class="road-card">
          <div class="road-card__meta"><span>🎯 SPECIALIST</span><time>2 → 4 năm</time></div>
          <h3>Giỏi một thứ trước khi đa nhiệm</h3>
          <ul>
            <li>Chuyên sâu một lĩnh vực</li>
            <li>KPI</li>
            <li>Data</li>
            <li>Analytics</li>
            <li>Optimization</li>
            <li>Automation cơ bản</li>
          </ul>
          <blockquote>“Giỏi một thứ trước khi đa nhiệm.”</blockquote>
        </div>
      </article>

      <article class="road-level reveal-up">
        <div class="road-level__node">04</div>
        <div class="road-card">
          <div class="road-card__meta"><span>👥 TEAM LEADER</span><time>4 → 5 năm</time></div>
          <h3>Từ làm tốt sang giúp cả team làm tốt</h3>
          <ul>
            <li>Team management</li>
            <li>Planning</li>
            <li>KPI allocation</li>
            <li>Training</li>
            <li>Workflow</li>
          </ul>
          <p class="road-highlight">Từ làm tốt<br />→ sang giúp cả team làm tốt.</p>
        </div>
      </article>

      <article class="road-level reveal-up">
        <div class="road-level__node">05</div>
        <div class="road-card">
          <div class="road-card__meta"><span>🧠 MARKETING MANAGER</span><time>5 năm+</time></div>
          <h3>Giải bài toán tăng trưởng</h3>
          <ul>
            <li>Strategy</li>
            <li>Branding</li>
            <li>Finance mindset</li>
            <li>Business thinking</li>
            <li>System building</li>
          </ul>
          <p class="road-highlight">Không còn là chạy Ads.<br />Mà là giải bài toán tăng trưởng.</p>
        </div>
      </article>

      <article class="road-level road-level--ai reveal-up">
        <div class="road-level__node">06</div>
        <div class="road-card road-card--wide">
          <div class="road-card__meta"><span>🤖 AI MARKETING ERA</span><time>Now → Next</time></div>
          <h3>AI là năng lực tăng tốc, không phải nền móng thay thế tư duy</h3>
          <div class="ai-card-grid">
            <span>AI Content</span>
            <span>AI SEO</span>
            <span>AI Automation</span>
            <span>AI Chatbot</span>
            <span>AI Design</span>
          </div>
          <blockquote class="ai-quote">“AI không thay thế marketer. AI thay thế marketer không biết dùng AI.”</blockquote>
        </div>
      </article>
    </div>
  </section>

  <section class="learn-flow-section">
    <div class="roadmap-section__head reveal-up">
      <p class="roadmap-kicker">Bạn nên học gì?</p>
      <h2>Đi theo đúng thứ tự năng lực</h2>
    </div>
    <div class="learn-flow" id="learnFlow">
      <% ['Foundation', 'Content / Design', 'Ads / SEO', 'Data / Analytics', 'Strategy', 'Leadership', 'AI & Automation'].forEach(function(item) { %>
        <div class="learn-step reveal-up"><%= item %></div>
      <% }); %>
    </div>
  </section>

  <section class="mentor-section">
    <div class="roadmap-section__head reveal-up">
      <p class="roadmap-kicker">Những điều không AI dạy</p>
      <h2>Tư duy quyết định tốc độ trưởng thành</h2>
    </div>
    <div class="mentor-grid">
      <article class="mentor-card reveal-up"><span>01</span><p>Đừng học tool trước khi hiểu khách hàng.</p></article>
      <article class="mentor-card reveal-up"><span>02</span><p>Content tốt giúp Ads rẻ hơn.</p></article>
      <article class="mentor-card reveal-up"><span>03</span><p>Brand mạnh giúp bán hàng dễ hơn.</p></article>
      <article class="mentor-card reveal-up"><span>04</span><p>AI giúp tăng tốc — nhưng không thay thế tư duy.</p></article>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<script src="/js/main.js" defer></script>
<script>
  window.addEventListener('DOMContentLoaded', function () {
    const branches = document.querySelectorAll('.skill-branch');
    const target = document.getElementById('skillRoadmap');
    function renderPath(button) {
      branches.forEach(function (branch) { branch.classList.remove('active'); });
      button.classList.add('active');
      target.innerHTML = button.dataset.path.split('|').map(function (step) {
        return '<span>' + step + '</span>';
      }).join('<i>↓</i>');
    }
    branches.forEach(function (branch) {
      branch.addEventListener('mouseenter', function () { renderPath(branch); });
      branch.addEventListener('focus', function () { renderPath(branch); });
    });
    if (branches[0]) renderPath(branches[0]);

    function keepRoadmapActive() {
      document.querySelectorAll('.nav__link').forEach(function (link) {
        link.classList.toggle('active-link', link.getAttribute('href') === '/growth-roadmap');
      });
    }
    keepRoadmapActive();
    window.addEventListener('scroll', keepRoadmapActive, { passive: true });

    const flow = document.getElementById('learnFlow');
    function updateFlow() {
      if (!flow) return;
      const rect = flow.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)));
      flow.style.setProperty('--fill', Math.round(progress * 100) + '%');
    }
    updateFlow();
    window.addEventListener('scroll', updateFlow, { passive: true });
  });
</script>
<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/_vercel/speed-insights/script.js"></script>
</body>
</html>
