<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>&#272;&#259;ng nh&#7853;p qu&#7843;n tr&#7883; | Portfolio</title>
  <link rel="icon" href="/images/software/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" /></noscript>
  <link rel="stylesheet" href="/css/style.css?v=20260527-brief-submit-align" />
  <link rel="stylesheet" href="/css/login.css?v=20260527-auth-green-split" />
</head>
<body class="login-page">
  <main class="login-shell">
    <section class="auth-card" aria-labelledby="loginTitle">
      <aside class="auth-visual" aria-label="Project Admin">
        <a class="auth-logo" href="/" aria-label="V&#7873; trang ch&#7911;">
          <span>HS</span>
        </a>
        <h2>Welcome Back!</h2>
        <p>Truy c&#7853;p khu v&#7921;c qu&#7843;n tr&#7883; d&#7921; &#225;n b&#7857;ng t&#224;i kho&#7843;n &#273;&#227; &#273;&#432;&#7907;c c&#7845;p quy&#7873;n.</p>
        <a class="auth-ghost" href="/register">&#272;&#259;ng k&#253;</a>
      </aside>

      <section class="login-panel auth-form-panel">
        <p class="login-kicker">Project Admin</p>
        <h1 id="loginTitle">welcome</h1>
        <p class="login-copy">Log in to your account to continue</p>

        <% if (error) { %>
          <div class="login-alert" role="alert"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="login-alert login-alert--success" role="status"><%= success %></div>
        <% } %>

        <form class="login-form" action="/login" method="POST" autocomplete="on">
          <label>
            <span>T&#224;i kho&#7843;n</span>
            <input name="username" type="text" autocomplete="username" placeholder="Email hoặc username" required autofocus />
          </label>
          <label>
            <span>M&#7853;t kh&#7849;u</span>
            <input name="password" type="password" autocomplete="current-password" placeholder="Password" required />
          </label>
          <a class="auth-muted-link" href="/register">Forgot your password?</a>
          <button class="login-submit" type="submit">LOG IN</button>
        </form>

        <p class="auth-switch">Don't have an account? <a href="/register">sign up</a></p>
      </section>
    </section>
  </main>
</body>
</html>
