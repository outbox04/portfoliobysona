<section class="eco-section eco-section--alt" id="ai" data-eco="ai">
  <div class="container">
    <div class="eco-label reveal-up">🤖 AI Integration</div>
    <h2 class="eco-title reveal-up">AI đang hỗ trợ<br /><em>từng phòng ban ra sao?</em></h2>
    <p class="eco-sub reveal-up">Ma trận AI Impact — mức độ tự động hóa, ứng dụng thực tế và mức độ rủi ro bị thay thế của từng mảng.</p>

    <div style="overflow-x:auto" class="reveal-up">
      <table class="eco-matrix">
        <thead>
          <tr>
            <th>Phòng ban</th>
            <th>AI Use Cases</th>
            <th>AI Impact</th>
            <th>Automation</th>
            <th>Future Risk</th>
          </tr>
        </thead>
        <tbody>
          <%
          const matrix = [
            { icon:'🏷️', dept:'Branding',         uses:['Campaign concept','Moodboard','Insight analysis'],         impact:90, auto:'Medium', risk:'low' },
            { icon:'⚡', dept:'Performance',       uses:['Ad copy','Creative gen','Audience opt','CTR predict'],      impact:95, auto:'High',   risk:'med' },
            { icon:'✍️', dept:'Content',           uses:['Article writing','Hook gen','SEO opt','Script'],            impact:92, auto:'High',   risk:'high'},
            { icon:'📱', dept:'Social Media',      uses:['Caption gen','Trend analysis','Auto reply'],                impact:85, auto:'Medium', risk:'med' },
            { icon:'🔍', dept:'SEO / GEO',         uses:['Keyword cluster','Intent analysis','GEO content'],          impact:88, auto:'High',   risk:'high'},
            { icon:'🎨', dept:'Design',            uses:['Concept gen','Banner auto','Background removal'],            impact:80, auto:'Medium', risk:'med' },
            { icon:'🎬', dept:'Video',             uses:['Script gen','Auto subtitle','Voice clone'],                  impact:78, auto:'Medium', risk:'low' },
            { icon:'🤝', dept:'CRM & Auto',        uses:['Chatbot','Lead scoring','Email personalize'],               impact:96, auto:'High',   risk:'med' },
            { icon:'📊', dept:'Analytics',         uses:['Data predict','Anomaly detect','NL query'],                 impact:94, auto:'High',   risk:'high'},
            { icon:'🤖', dept:'AI Marketing',      uses:['Full automation','Agent build','Multi-model'],              impact:100,auto:'Full',   risk:'low' },
          ];
          matrix.forEach(m => { %>
          <tr>
            <td><span class="eco-matrix__dept"><span><%= m.icon %></span> <%= m.dept %></span></td>
            <td>
              <div class="eco-matrix__uses">
                <% m.uses.forEach(u => { %><span class="eco-tag eco-tag--ai"><%= u %></span><% }); %>
              </div>
            </td>
            <td>
              <div class="eco-matrix__meter">
                <div class="eco-matrix__bar"><div class="eco-matrix__fill" data-w="<%= m.impact %>" style="width:0"></div></div>
                <span class="eco-matrix__pct"><%= m.impact %>%</span>
              </div>
            </td>
            <td><span class="eco-tag eco-tag--ai"><%= m.auto %></span></td>
            <td><span class="eco-risk eco-risk--<%= m.risk %>"><%= m.risk === 'low' ? '🟢 Thấp' : m.risk === 'med' ? '🟡 Trung bình' : '🔴 Cao' %></span></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

