<!-- ══════════════════════════════════════
     1. HERO
══════════════════════════════════════ -->
<section class="eco-hero" data-eco="hero">
  <div class="eco-hero__bg">
    <div class="eco-hero__orb orb-1"></div>
    <div class="eco-hero__orb orb-2"></div>
    <div class="eco-hero__orb orb-3"></div>
    <div class="eco-hero__grid"></div>
  </div>
  <div class="container">
    <div class="eco-hero__content">
      <div class="eco-hero__badge reveal-up">
        <span></span> Marketing Ecosystem
      </div>
      <h1 class="eco-hero__title reveal-up">
        <span class="line-1">MARKETING</span>
        <span class="line-2">ECOSYSTEM</span>
        <span class="line-3">& AI</span>
      </h1>
      <p class="eco-hero__sub reveal-up">Toàn cảnh hệ sinh thái Marketing hiện đại — 10+ mảng chuyên môn, 50+ vị trí nghề nghiệp và cách AI đang tái định hình từng phòng ban.</p>
      <div class="eco-hero__cta reveal-up">
        <a href="#overview" class="btn--eco-primary" onclick="document.querySelector('[data-eco=overview]').scrollIntoView({behavior:'smooth'});return false">
          Explore Ecosystem
        </a>
        <a href="#ai" class="btn--eco-ghost" onclick="document.querySelector('[data-eco=ai]').scrollIntoView({behavior:'smooth'});return false">
          AI in Marketing
        </a>
      </div>
      <div class="eco-hero__stats reveal-up">
        <div class="eco-stat">
          <span class="eco-stat__num" data-target="10" data-suffix="+">0+</span>
          <span class="eco-stat__label">Marketing Fields</span>
        </div>
        <div class="eco-stat">
          <span class="eco-stat__num" data-target="50" data-suffix="+">0+</span>
          <span class="eco-stat__label">Career Positions</span>
        </div>
        <div class="eco-stat">
          <span class="eco-stat__num" data-target="100" data-suffix="+">0+</span>
          <span class="eco-stat__label">AI Use Cases</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     2. OVERVIEW
══════════════════════════════════════ -->
<section class="eco-section eco-section--alt" id="overview" data-eco="overview">
  <div class="container">
    <div class="eco-label reveal-up">🌐 Hệ sinh thái</div>
    <h2 class="eco-title reveal-up">Marketing gồm<br /><em>những mảng nào?</em></h2>
    <p class="eco-sub reveal-up">Mỗi mảng là một hệ thống chuyên môn riêng biệt — nhưng chúng kết nối và hỗ trợ lẫn nhau để tạo nên chiến lược Marketing tổng thể.</p>

    <div class="eco-overview-grid">
      <%
      const depts = [
        { icon:'🏷️', name:'Branding',           desc:'Xây dựng nhận diện & cảm xúc thương hiệu',     ai:90, color:'rgba(230,48,34,0.08)',   border:'rgba(230,48,34,0.2)' },
        { icon:'⚡', name:'Performance',         desc:'Tối ưu quảng cáo & đo lường kết quả',          ai:95, color:'rgba(245,158,11,0.08)',  border:'rgba(245,158,11,0.2)' },
        { icon:'✍️', name:'Content Marketing',   desc:'Tạo nội dung giá trị thu hút & chuyển đổi',    ai:92, color:'rgba(16,185,129,0.08)', border:'rgba(16,185,129,0.2)' },
        { icon:'📱', name:'Social Media',         desc:'Xây dựng cộng đồng & tương tác đa nền tảng',  ai:85, color:'rgba(99,179,237,0.08)',  border:'rgba(99,179,237,0.2)' },
        { icon:'🔍', name:'SEO / GEO',            desc:'Tối ưu tìm kiếm & AI search engine',          ai:88, color:'rgba(124,58,237,0.08)', border:'rgba(124,58,237,0.2)' },
        { icon:'🎨', name:'Design Creative',      desc:'Thiết kế visual & sản xuất ấn phẩm',          ai:80, color:'rgba(236,72,153,0.08)',  border:'rgba(236,72,153,0.2)' },
        { icon:'🎬', name:'Video Production',     desc:'Sản xuất video đa nền tảng & storytelling',   ai:78, color:'rgba(6,182,212,0.08)',   border:'rgba(6,182,212,0.2)'  },
        { icon:'🤝', name:'CRM & Automation',     desc:'Tự động hóa chăm sóc & nuôi dưỡng khách hàng',ai:96, color:'rgba(16,185,129,0.08)', border:'rgba(16,185,129,0.2)' },
        { icon:'📊', name:'Data Analytics',       desc:'Phân tích dữ liệu & đưa ra insight',          ai:94, color:'rgba(245,158,11,0.08)',  border:'rgba(245,158,11,0.2)' },
        { icon:'🤖', name:'AI Marketing',         desc:'Ứng dụng AI vào workflow marketing',           ai:100,color:'rgba(124,58,237,0.08)', border:'rgba(124,58,237,0.2)' },
      ];
      depts.forEach(d => { %>
      <div class="eco-dept-card reveal-up" data-color="<%= d.color %>" data-border="<%= d.border %>">
        <span class="eco-dept-icon"><%= d.icon %></span>
        <div class="eco-dept-name"><%= d.name %></div>
        <div class="eco-dept-desc"><%= d.desc %></div>
        <div class="ai-impact">
          <span class="ai-impact__label">AI</span>
          <div class="ai-impact__bar"><div class="ai-impact__fill" data-w="<%= d.ai %>"></div></div>
          <span class="ai-impact__pct"><%= d.ai %>%</span>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

