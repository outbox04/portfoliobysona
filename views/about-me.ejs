          </div>
        </aside>
      </div>
    </section>

    <figure class="seo-image-band reveal-up">
      <img src="/images/about-me/tran-hong-son-marketing-journey.webp" alt="Hành trình phát triển Marketing của Trần Hồng Sơn" width="1600" height="900" loading="lazy" decoding="async" />
